{
  "name": "vampire-client",
  "version": "0.3.0",
  "private": true,
  "author": "Vampire Studios",
  "description": "An open-source-in-development Minecraft Java launcher by Vampire Studios.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --universal"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xmcl/core": "2.13.0",
    "@xmcl/installer": "5.4.0",
    "@xmcl/user": "4.4.2",
    "@azure/msal-node": "^3.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "43.8.7",
    "electron-builder": "26.18.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "fun.vampirenodes.client",
    "productName": "Vampire Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "VampireClient-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Vampire Studios <noreply@github.com>",
      "vendor": "Vampire Studios",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "artifactName": "VampireClient-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "VampireClient-Portable-${version}-${arch}.${ext}"
    }
  },
  "desktopName": "Vampire Client",
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "undici": "^6.29.1",
    "minimatch": "^11.0.1",
    "uuid": "^11.1.0"
  }
}